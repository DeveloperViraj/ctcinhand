---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Byline from '../components/Byline.astro';
import { absolute, article, pagePath, type Crumb, type JsonLdNode } from '../lib/seo';
import { ogImagePath } from '../lib/og';

interface Props {
  title: string;
  description: string;
  /** ISO date the content was last materially changed. */
  updated?: string;
  /** ISO date the page first went live. Defaults to `updated`. */
  published?: string;
  noindex?: boolean;
  /** Trail above this page, e.g. [{ name: 'Professional tax', path: '/professional-tax' }]. */
  parents?: readonly Crumb[];
  ogImage?: string;
  /** Extra structured data for this page (a Dataset, for example). */
  schema?: readonly JsonLdNode[];
  /** Topics for the Article node. */
  about?: string[];
  /**
   * Legal pages (privacy, terms) keep their "Last updated" date but are not articles: they speak
   * for the site, so they credit no individual author.
   */
  legal?: boolean;
  ogType?: 'article' | 'profile';
  pageType?: 'WebPage' | 'ProfilePage';
  mainEntity?: string;
}

const {
  title,
  description,
  updated,
  published = updated,
  noindex,
  parents = [],
  ogImage = 'default',
  schema = [],
  about,
  legal = false,
  ogType = 'article',
  pageType,
  mainEntity,
} = Astro.props;

const path = pagePath(Astro.url.pathname);
const breadcrumbs: Crumb[] = [{ name: 'Home', path: '/' }, ...parents, { name: title, path }];

// Legal and contact pages carry no date and are not articles; explainers are.
const articleNode =
  updated && published && !legal
    ? [
        article({
          url: absolute(path),
          headline: title,
          description,
          image: absolute(ogImagePath(ogImage)),
          datePublished: published,
          dateModified: updated,
          about,
        }),
      ]
    : [];
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  ogType={ogType}
  pageType={pageType}
  mainEntity={mainEntity}
  ogImage={ogImage}
  breadcrumbs={breadcrumbs}
  schema={[...articleNode, ...schema]}
  datePublished={published}
  dateModified={updated}
>
  <article class="mx-auto max-w-6xl px-4 pt-8 pb-4 sm:px-6 sm:pt-12">
    <header class="max-w-[68ch]">
      <Breadcrumbs crumbs={breadcrumbs} />
      <h1 class="mt-4 text-2xl font-medium tracking-tight text-ink sm:text-3xl">{title}</h1>
      {updated && <Byline updated={updated} credit={!legal} />}
    </header>
    <div class="prose-doc mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
