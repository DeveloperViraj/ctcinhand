---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Byline from '../components/Byline.astro';
import { absolute, article, pagePath, type Crumb, type JsonLdNode } from '../lib/seo';
import { ogImagePath } from '../lib/og';

interface Props {
  title: string;
  description: string;
  /** ISO date the content was last materially changed. */
  updated?: string;
  /** ISO date the page first went live. Defaults to `updated`. */
  published?: string;
  noindex?: boolean;
  /** Trail above this page, e.g. [{ name: 'Professional tax', path: '/professional-tax' }]. */
  parents?: readonly Crumb[];
  ogImage?: string;
  /** Extra structured data for this page (a Dataset, for example). */
  schema?: readonly JsonLdNode[];
  /** Topics for the Article node. */
  about?: string[];
  /**
   * Legal pages (privacy, terms) keep their "Last updated" date but are not articles: they speak
   * for the site, so they credit no individual author.
   */
  legal?: boolean;
  ogType?: 'article' | 'profile';
  pageType?: 'WebPage' | 'ProfilePage';
  mainEntity?: string;
  /** Leave the description out of the page header, for pages that open with the same words. */
  hideLede?: boolean;
  /**
   * A Devanagari word set above the title as ornament, e.g. वेतन (salary) or कर (tax). It must use
   * only letters in the Eczar art subset (src/assets/fonts), or it falls back to a system font.
   */
  deva?: string;
}

const {
  title,
  description,
  updated,
  published = updated,
  noindex,
  parents = [],
  ogImage = 'default',
  schema = [],
  about,
  legal = false,
  ogType = 'article',
  pageType,
  mainEntity,
  hideLede = false,
  deva,
} = Astro.props;

const path = pagePath(Astro.url.pathname);
const breadcrumbs: Crumb[] = [{ name: 'Home', path: '/' }, ...parents, { name: title, path }];

// Legal and contact pages carry no date and are not articles; explainers are.
const articleNode =
  updated && published && !legal
    ? [
        article({
          url: absolute(path),
          headline: title,
          description,
          image: absolute(ogImagePath(ogImage)),
          datePublished: published,
          dateModified: updated,
          about,
        }),
      ]
    : [];
---

<BaseLayout
  title={title}
  description={description}
  noindex={noindex}
  ogType={ogType}
  pageType={pageType}
  mainEntity={mainEntity}
  ogImage={ogImage}
  breadcrumbs={breadcrumbs}
  schema={[...articleNode, ...schema]}
  datePublished={published}
  dateModified={updated}
>
  <article>
    <header class="relative isolate overflow-x-clip">
      <div class="hero-glow opacity-80" aria-hidden="true"></div>
      <div
        class="art-rosette art-spin absolute -top-12 -right-40 -z-10 size-[300px] opacity-20 md:-top-32 md:-right-40 md:size-[620px] md:opacity-30"
        aria-hidden="true"
      ></div>
      <div class="mx-auto max-w-6xl px-4 pt-8 pb-10 sm:px-6 sm:pt-14 sm:pb-14">
        <Breadcrumbs crumbs={breadcrumbs} />
        {deva && (
          <p class="deva mt-6 text-2xl text-saffron-ink" lang="hi" aria-hidden="true">
            {deva}
          </p>
        )}
        <h1
          class:list={['display max-w-4xl text-4xl text-ink sm:text-6xl', deva ? 'mt-1' : 'mt-5']}
        >
          {title}
        </h1>
        {!hideLede && <p class="mt-5 max-w-2xl text-lg text-ink-2">{description}</p>}
        {updated && <Byline updated={updated} credit={!legal} />}
      </div>
      <div class="art-band" aria-hidden="true"></div>
    </header>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:grid lg:grid-cols-[minmax(0,1fr)_13rem] lg:gap-16">
      <div class="prose-doc pt-10 sm:pt-12" data-doc>
        <slot />
      </div>
      <aside class="hidden pt-12 lg:block">
        <nav class="sticky top-24" aria-labelledby="toc-heading" data-toc hidden>
          <p id="toc-heading" class="text-xs font-semibold text-ink">
            On this page
          </p>
          <ol class="mt-3 space-y-1 border-l border-line text-sm"></ol>
        </nav>
      </aside>
    </div>
  </article>
</BaseLayout>

<script>
  /*
   * "On this page": built from the article's own h2s, so it can never list a section that is not
   * there. Pages with fewer than three sections do without it. The current section is highlighted
   * as you scroll.
   */
  const doc = document.querySelector<HTMLElement>('[data-doc]');
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const list = toc?.querySelector('ol');
  const headings = doc ? [...doc.querySelectorAll<HTMLHeadingElement>(':scope > h2')] : [];
  if (doc && toc && list && headings.length >= 3) {
    const slug = (text: string) =>
      text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-|-$/g, '');
    const links = headings.map((h) => {
      if (!h.id) h.id = slug(h.textContent ?? '');
      const item = document.createElement('li');
      const link = document.createElement('a');
      link.href = `#${h.id}`;
      link.textContent = h.textContent;
      link.className =
        '-ml-px block border-l border-transparent py-1 pl-3 text-ink-3 no-underline transition-colors hover:text-ink aria-[current=true]:border-accent aria-[current=true]:font-medium aria-[current=true]:text-ink';
      item.append(link);
      list.append(item);
      return link;
    });
    toc.hidden = false;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = headings.indexOf(entry.target as HTMLHeadingElement);
          links.forEach((link, i) => link.setAttribute('aria-current', String(i === index)));
        }
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
