---
import { Font } from 'astro:assets';
import { AUTHOR } from '../config/author';
import { SITE } from '../config/site';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ogImagePath, OG_HEIGHT, OG_WIDTH } from '../lib/og';
import {
  absolute,
  breadcrumbList,
  pagePath,
  organization,
  person,
  webPage,
  website,
  type Crumb,
  type JsonLdNode,
} from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Error pages set this so they never enter the index. */
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'profile';
  /** Schema.org type of the page node. */
  pageType?: 'WebPage' | 'ProfilePage';
  /** @id of the page's main entity, e.g. the author on a profile page. */
  mainEntity?: string;
  /** Social card slug from src/lib/og-cards.ts. */
  ogImage?: string;
  /** Trail from the home page to this page, inclusive. Omit on the home page. */
  breadcrumbs?: readonly Crumb[];
  /** Page-specific structured data, merged into the site-wide graph. */
  schema?: readonly JsonLdNode[];
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  description,
  noindex = false,
  ogType = 'website',
  ogImage = 'default',
  breadcrumbs,
  schema = [],
  datePublished,
  dateModified,
  pageType,
  mainEntity,
} = Astro.props;
const canonicalPath = pagePath(Astro.url.pathname);
const canonical = absolute(canonicalPath);
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const image = absolute(ogImagePath(ogImage));

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    organization(),
    website(),
    ...(AUTHOR ? [person(AUTHOR)] : []),
    webPage({
      url: canonical,
      title: fullTitle,
      description,
      hasBreadcrumb: Boolean(breadcrumbs?.length),
      image,
      datePublished,
      dateModified,
      type: pageType,
      mainEntity,
    }),
    ...(breadcrumbs?.length ? [breadcrumbList(breadcrumbs, canonical)] : []),
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en-IN" data-theme="light" data-theme-pref="system">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fafcfd" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#11181e" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline></script>
    )}

    <Font cssVariable="--font-plex" preload />

    <!-- Resolve the theme before first paint so dark-mode users never see a white flash. -->
    <script is:inline>
      (() => {
        const KEY = 'inhand:theme';
        const root = document.documentElement;
        const mq = window.matchMedia('(prefers-color-scheme: dark)');
        const read = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : 'system';
          } catch {
            return 'system';
          }
        };
        const apply = (pref) => {
          root.dataset.themePref = pref;
          root.dataset.theme = pref === 'system' ? (mq.matches ? 'dark' : 'light') : pref;
        };
        window.__setThemePref = (pref) => {
          try {
            if (pref === 'system') localStorage.removeItem(KEY);
            else localStorage.setItem(KEY, pref);
          } catch {
            /* storage unavailable: theme still applies for this page view */
          }
          apply(pref);
        };
        mq.addEventListener('change', () => {
          if (read() === 'system') apply('system');
        });
        apply(read());
      })();
    </script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-sm focus:bg-surface focus:px-3 focus:py-2 focus:text-ink"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
