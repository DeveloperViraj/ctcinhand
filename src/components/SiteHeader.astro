---
import { Icon } from 'astro-icon/components';
import { SITE } from '../config/site';
import { pagePath } from '../lib/seo';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';

const path = pagePath(Astro.url.pathname);
const nav = [
  { href: '/', label: 'Calculator' },
  { href: '/in-hand-salary', label: 'Salaries' },
  { href: '/old-vs-new-tax-regime', label: 'Old vs new' },
  { href: '/how-it-works', label: 'How it works', wide: true },
];
const tools = [
  {
    href: '/salary-hike-calculator',
    label: 'Salary hike calculator',
    text: 'What a raise adds to your monthly pay',
    icon: 'lucide:trending-up',
    isNew: true,
  },
  {
    href: '/gratuity-calculator',
    label: 'Gratuity calculator',
    text: 'On Labour Code wages, from one year for fixed-term',
    icon: 'lucide:hand-coins',
    isNew: false,
  },
];
// The phone menu has room for the guides as well.
const more = [
  { href: '/ctc-vs-in-hand-salary', label: 'CTC vs in-hand' },
  { href: '/provident-fund', label: 'Provident fund' },
  { href: '/professional-tax', label: 'Professional tax' },
];
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-4">
  <div class="glass mx-auto flex h-14 max-w-6xl items-center justify-between gap-3 rounded-pill border border-line pr-2 pl-4 shadow-sm">
    <a
      href="/"
      class="flex items-center gap-2.5 font-display text-lg font-bold tracking-tight text-ink no-underline"
    >
      <Logo class="size-8" />
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Primary" class="flex items-center gap-1">
      <ul class="hidden items-center gap-0.5 text-sm md:flex">
        {nav.slice(0, 1).map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="rounded-pill px-3.5 py-2 font-medium text-ink-2 no-underline transition-colors hover:bg-sunken hover:text-ink aria-[current=page]:bg-sunken aria-[current=page]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
        <li>
          <details class="tools relative" data-header-menu>
            <summary
              class:list={[
                'flex cursor-pointer list-none items-center gap-1 rounded-pill px-3.5 py-2 font-medium text-ink-2 transition-colors hover:bg-sunken hover:text-ink [&::-webkit-details-marker]:hidden',
                tools.some((t) => isCurrent(t.href)) && 'bg-sunken text-ink',
              ]}
            >
              Tools
              <Icon name="lucide:chevron-down" class="tools-chevron size-3.5" aria-hidden="true" />
            </summary>
            <div class="absolute top-12 left-1/2 w-80 -translate-x-1/2 rounded-lg border border-line bg-surface p-2 shadow-md">
              <ul>
                {tools.map((t) => (
                  <li>
                    <a
                      href={t.href}
                      aria-current={isCurrent(t.href) ? 'page' : undefined}
                      class="flex items-start gap-3 rounded-sm px-3 py-2.5 no-underline hover:bg-sunken"
                    >
                      <Icon
                        name={t.icon}
                        class="mt-0.5 size-4 shrink-0 text-accent"
                        aria-hidden="true"
                      />
                      <span class="min-w-0 flex-1">
                        <span class="flex items-center gap-2 font-medium text-ink">
                          {t.label}
                          {t.isNew && <span class="badge-dot">New</span>}
                        </span>
                        <span class="block text-xs text-ink-3">{t.text}</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </li>
        {nav.slice(1).map((item) => (
          <li class:list={[item.wide && 'hidden lg:block']}>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="rounded-pill px-3.5 py-2 font-medium text-ink-2 no-underline transition-colors hover:bg-sunken hover:text-ink aria-[current=page]:bg-sunken aria-[current=page]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
      <a href="/#calc" class="btn btn-solid btn-sm hidden sm:inline-flex">
        Calculate
      </a>
      <details class="menu relative md:hidden" data-header-menu>
        <summary
          class="flex size-9 cursor-pointer list-none items-center justify-center rounded-pill text-ink-2 hover:bg-sunken hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Menu"
        >
          <Icon name="lucide:menu" class="menu-open size-5" aria-hidden="true" />
          <Icon name="lucide:x" class="menu-close size-5" aria-hidden="true" />
        </summary>
        <div class="absolute top-12 right-0 w-64 rounded-lg border border-line bg-surface p-2 shadow-md">
          <ul class="text-sm">
            {[...nav.slice(0, 1), ...tools, ...nav.slice(1), ...more].map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class="block rounded-sm px-3 py-2.5 font-medium text-ink-2 no-underline hover:bg-sunken hover:text-ink aria-[current=page]:text-accent-ink"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* The icons are rendered by astro-icon, outside this component's scope. */
  .menu :global(.menu-close),
  .menu[open] :global(.menu-open) {
    display: none;
  }
  .menu[open] :global(.menu-close) {
    display: block;
  }
  .tools[open] :global(.tools-chevron) {
    transform: rotate(180deg);
  }
</style>

<script>
  // Native <details> menus stay open until toggled. Close them on Escape, on a click elsewhere, and
  // when another one opens, as a menu is expected to.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-header-menu]'));
  const closeAll = (except?: HTMLDetailsElement) => {
    for (const menu of menus) if (menu !== except) menu.open = false;
  };
  for (const menu of menus) {
    menu.addEventListener('toggle', () => {
      if (menu.open) closeAll(menu);
    });
  }
  document.addEventListener('click', (event) => {
    if (!menus.some((menu) => menu.contains(event.target as Node))) closeAll();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const open = menus.find((menu) => menu.open);
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
</script>
