---
/**
 * A round office stamp, the kind on every Indian form and receipt: हाथ में ("in hand") in the
 * centre, a line of small text round the rim. Purely decorative.
 */
import { SITE } from '../config/site';

interface Props {
  class?: string;
  /** Text round the rim. */
  rim?: string;
}
const { class: className, rim = 'what actually reaches your bank, every month,' } = Astro.props;
const id = `stamp-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 160 160" class={className} aria-hidden="true" focusable="false">
  <defs>
    <path id={id} d="M80 80m-58 0a58 58 0 1 1 116 0a58 58 0 1 1-116 0"></path>
  </defs>
  <g class="fill-none stroke-saffron-ink">
    <circle cx="80" cy="80" r="74" stroke-width="2.5"></circle>
    <circle cx="80" cy="80" r="68" stroke-width="0.8"></circle>
    <circle cx="80" cy="80" r="46" stroke-width="0.8" stroke-dasharray="2 3"></circle>
  </g>
  <text class="fill-saffron-ink font-sans text-[9.5px] font-semibold tracking-[0.12em]">
    <textPath href={`#${id}`} textLength="360" lengthAdjust="spacing">
      {rim}
    </textPath>
  </text>
  <text x="80" y="86" text-anchor="middle" class="deva fill-saffron-ink text-[26px]" lang="hi">
    हाथ में
  </text>
  <text
    x="80"
    y="106"
    text-anchor="middle"
    class="fill-saffron-ink font-sans text-[8px] font-semibold tracking-[0.18em]"
  >
    {SITE.shortYearLabel}
  </text>
</svg>
