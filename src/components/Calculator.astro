---
import { Icon } from 'astro-icon/components';
import { calculate } from '../lib/tax/calculate';
import { DEFAULT_INPUT } from '../lib/tax/defaults';
import { HRA_CITY_OPTIONS } from '../lib/tax/hra';
import { STATES } from '../lib/tax/professional-tax';
import { renderDetails, renderSummary } from '../lib/render-result';
import NumberField from './form/NumberField.astro';
import ComponentField from './form/ComponentField.astro';
import SelectField from './form/SelectField.astro';
import Segmented from './form/Segmented.astro';

// Rendered at build time so the page carries real numbers before any JavaScript runs.
const initialResult = calculate(DEFAULT_INPUT);
const summary = renderSummary(initialResult);
const details = renderDetails(initialResult);

// Short labels so a chip and its unit switch always fit on one line, even on a phone.
const PCT_CTC = { value: 'percent', label: '% CTC' };
const PCT_BASIC = { value: 'percent', label: '% Basic' };
const RUPEES = { value: 'rupees', label: '₹/yr' };

const checkbox = 'mt-0.5 size-4 shrink-0 rounded-xs accent-[var(--color-accent)]';
const legend = 'text-base font-semibold text-ink';

/** One tap to the salaries people most often type. */
const PRESETS = [
  { label: '6L', value: 6_00_000 },
  { label: '10L', value: 10_00_000 },
  { label: '12L', value: 12_00_000 },
  { label: '15L', value: 15_00_000 },
  { label: '20L', value: 20_00_000 },
  { label: '30L', value: 30_00_000 },
  { label: '50L', value: 50_00_000 },
];
---

<form id="calc" novalidate class="scroll-mt-24">
  <!--
    One floating panel: inputs on the left, the live result on a tinted column to the right. The
    result column is sticky inside the panel, so it stays beside a long Advanced form.
  -->
  <!-- overflow-clip, not hidden: hidden would make the panel a scroll container and stop the sticky result. -->
  <div class="panel overflow-clip">
    <div class="grid lg:grid-cols-[minmax(0,1fr)_minmax(0,27rem)]">
      <!-- Inputs -->
      <div class="p-5 sm:p-8" data-inputs>
        <div class="flex items-center justify-between gap-3">
          <label for="ctc" class="text-sm font-semibold text-ink">
            Annual CTC
          </label>
          <span class="text-xs text-ink-3">Type a number or something like 18L</span>
        </div>
        <div class="chip chip-xl mt-3 w-full justify-start" style="--chip-width:100%">
          <span class="chip-unit" aria-hidden="true">
            ₹
          </span>
          <input
            id="ctc"
            name="ctc"
            type="text"
            inputmode="decimal"
            autocomplete="off"
            spellcheck="false"
            value="12,00,000"
            aria-describedby="ctc-presets-label"
            data-money
          />
        </div>
        <div class="mt-4">
          <input
            type="range"
            class="range"
            min="0"
            max="1000"
            step="1"
            value="0"
            tabindex="-1"
            aria-hidden="true"
            data-slider-for="ctc"
            data-kind="log"
            data-min="100000"
            data-max="20000000"
          />
          <div class="mt-1 flex justify-between text-xs text-ink-3" aria-hidden="true">
            <span>₹1 L</span>
            <span>₹2 Cr</span>
          </div>
        </div>
        <div
          class="mt-4 flex flex-wrap items-center gap-2"
          role="group"
          aria-labelledby="ctc-presets-label"
        >
          <span id="ctc-presets-label" class="mr-1 text-xs text-ink-3">
            Quick pick
          </span>
          {PRESETS.map((p) => (
            <button
              type="button"
              class="preset"
              data-ctc-preset={p.value}
              aria-pressed={p.value === DEFAULT_INPUT.ctc ? 'true' : 'false'}
              aria-label={`Set CTC to ${p.label}`}
            >
              {p.label}
            </button>
          ))}
        </div>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <SelectField id="state" label="Work state" hintId="pt-status">
            {STATES.map((s) => (
              <option value={s.code} selected={s.code === DEFAULT_INPUT.stateCode}>
                {s.name}
              </option>
            ))}
          </SelectField>
          <SelectField id="city" label="City you live in" hint="Sets the 50% or 40% HRA limit.">
            {HRA_CITY_OPTIONS.map((c) => (
              <option value={c} selected={c === DEFAULT_INPUT.city}>
                {c === 'Other' ? 'Anywhere else' : c}
              </option>
            ))}
          </SelectField>
        </div>

        <div class="mt-6">
          <NumberField
            id="rent"
            label="Monthly rent you pay"
            value="0"
            prefix="₹"
            width="6rem"
            hint="Only the old regime gives relief for rent."
            slider={{
              kind: 'linear',
              min: 0,
              max: 1_50_000,
              step: 1_000,
              minLabel: '₹0',
              maxLabel: '₹1.5 L',
            }}
            money
          />
        </div>

        <!-- Mode -->
        <div class="mt-7 flex items-center justify-between gap-4 rounded-md border border-line bg-surface-2 px-4 py-3.5">
          <div>
            <p class="text-sm font-semibold text-ink" id="mode-label">
              Advanced mode
            </p>
            <p class="mt-0.5 text-xs text-ink-3">Match every component to your offer letter.</p>
          </div>
          <button
            type="button"
            id="mode-toggle"
            role="switch"
            aria-checked="false"
            aria-controls="advanced"
            aria-labelledby="mode-label"
            class="group relative h-7 w-12 shrink-0 rounded-pill bg-line-strong transition-colors duration-200 aria-checked:bg-accent"
          >
            <span
              aria-hidden="true"
              class="absolute top-[3px] left-[3px] size-[22px] rounded-full bg-white shadow-sm transition-transform duration-200 group-aria-checked:translate-x-5"
            ></span>
          </button>
        </div>

        <div id="advanced" hidden class="mt-6 space-y-8">
          <fieldset class="space-y-5">
            <legend class={legend}>Salary structure</legend>
            <div class="grid gap-5 sm:grid-cols-2">
              <ComponentField
                id="basic"
                label="Basic + DA"
                value="50"
                units={[PCT_CTC, RUPEES]}
                unit="percent"
              />
              <ComponentField
                id="hra"
                label="HRA"
                value="50"
                units={[PCT_BASIC, RUPEES]}
                unit="percent"
              />
              <ComponentField
                id="lta"
                label="Leave travel allowance"
                value="0"
                units={[PCT_BASIC, RUPEES]}
                unit="percent"
              />
              <ComponentField
                id="variable"
                label="Variable pay or bonus"
                value="0"
                units={[PCT_CTC, RUPEES]}
                unit="percent"
              />
              <ComponentField
                id="nps"
                label="Employer NPS"
                value="0"
                units={[PCT_BASIC, RUPEES]}
                unit="percent"
              />
              <div class="sm:col-span-2">
                <ComponentField
                  id="special"
                  label="Special allowance"
                  value="0"
                  units={[{ value: 'balance', label: 'Balance' }, RUPEES, PCT_CTC]}
                  unit="balance"
                  hint="Balance absorbs whatever is left of your CTC."
                  disabled
                />
              </div>
            </div>
          </fieldset>

          <fieldset class="space-y-4 border-t border-line pt-6">
            <legend class={`${legend} float-left w-full`}>Provident fund</legend>
            <div class="clear-both">
              <SelectField
                id="pf-mode"
                label="Contribution basis"
                hint="Employers may cap PF at the statutory ceiling or contribute on your actual wages. Check your payslip."
              >
                <option value="ceiling">12% up to the ceiling (₹25,000 from Sep)</option>
                <option value="actual">12% of full wages</option>
                <option value="none">Not a PF member</option>
              </SelectField>
            </div>
            <div class="space-y-3 text-sm text-ink-2">
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="pf-in-ctc" checked class={checkbox} />
                <span>Employer PF is counted inside my CTC</span>
              </label>
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="gratuity-in-ctc" checked class={checkbox} />
                <span>Gratuity provision is inside my CTC</span>
              </label>
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="esi-in-ctc" checked class={checkbox} />
                <span>Employer ESI is inside my CTC</span>
              </label>
              <label class="flex items-start gap-2.5">
                <input type="checkbox" id="special-as-wages" class={checkbox} />
                <span>
                  Treat special allowance as wages in full
                  <span class="mt-0.5 block text-xs text-ink-3">
                    The statute can be read this way; the Ministry of Labour’s FAQs cannot. Changes
                    gratuity and ESI.
                  </span>
                </span>
              </label>
            </div>
          </fieldset>

          <fieldset class="border-t border-line pt-6">
            <legend class={`${legend} float-left w-full`}>About you</legend>
            <div class="clear-both space-y-5 pt-4">
              <div class="grid gap-5 sm:grid-cols-2">
                <NumberField id="age" label="Age" value="30" suffix="yrs" width="2.5rem" />
                <NumberField
                  id="years"
                  label="Years of service"
                  value="5"
                  suffix="yrs"
                  width="2.5rem"
                  inputmode="decimal"
                />
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <Segmented
                  name="employer-type"
                  legend="Employer"
                  value="other"
                  options={[
                    { value: 'other', label: 'Private or PSU' },
                    { value: 'government', label: 'Government' },
                  ]}
                />
                <Segmented
                  name="employment-type"
                  legend="Employment"
                  value="permanent"
                  options={[
                    { value: 'permanent', label: 'Permanent' },
                    { value: 'fixed-term', label: 'Fixed-term' },
                  ]}
                  hint="Fixed-term staff get gratuity after one year."
                />
              </div>
              <div class="grid gap-5 sm:grid-cols-2">
                <Segmented
                  name="pt-category"
                  legend="Professional tax slab"
                  value="men"
                  options={[
                    { value: 'men', label: 'Men' },
                    { value: 'women', label: 'Women' },
                  ]}
                  hint="Maharashtra exempts women up to ₹25,000 a month."
                />
                <NumberField
                  id="pt-override"
                  label="Professional tax a month"
                  value=""
                  prefix="₹"
                  width="3.5rem"
                  placeholder="auto"
                  hint="Leave on auto, or enter the figure from your payslip."
                />
              </div>
              <div class="space-y-3 text-sm text-ink-2">
                <label class="flex items-start gap-2.5">
                  <input type="checkbox" id="disabled" class={checkbox} />
                  <span>I am a person with a disability (raises the ESI ceiling)</span>
                </label>
                <label class="flex items-start gap-2.5">
                  <input type="checkbox" id="resident" checked class={checkbox} />
                  <span>I am a resident of India for tax purposes</span>
                </label>
              </div>
            </div>
          </fieldset>

          <fieldset class="border-t border-line pt-6">
            <legend class={`${legend} float-left w-full`}>Old regime deductions</legend>
            <p class="clear-both pt-1 text-sm text-ink-3">
              Only the old regime allows these. The new regime ignores them.
            </p>
            <div class="mt-5 space-y-6">
              <NumberField
                id="d-80c"
                label="80C investments"
                value="0"
                prefix="₹"
                width="5.5rem"
                hint="Section 123 of the new Act. Excluding your PF, which we add. Capped at ₹1.5 lakh."
                slider={{
                  kind: 'linear',
                  min: 0,
                  max: 1_50_000,
                  step: 1_000,
                  minLabel: '₹0',
                  maxLabel: '₹1.5 L',
                }}
                money
              />
              <NumberField
                id="d-nps"
                label="Your own NPS, 80CCD(1B)"
                value="0"
                prefix="₹"
                width="5.5rem"
                hint="Section 124(3) of the new Act. Capped at ₹50,000."
                slider={{
                  kind: 'linear',
                  min: 0,
                  max: 50_000,
                  step: 1_000,
                  minLabel: '₹0',
                  maxLabel: '₹50,000',
                }}
                money
              />
              <NumberField
                id="d-80d"
                label="Health insurance premium"
                value="0"
                prefix="₹"
                width="5.5rem"
                slider={{
                  kind: 'linear',
                  min: 0,
                  max: 1_00_000,
                  step: 1_000,
                  minLabel: '₹0',
                  maxLabel: '₹1 L',
                }}
                money
              />
              <NumberField
                id="d-home"
                label="Home loan interest"
                value="0"
                prefix="₹"
                width="5.5rem"
                hint="Self-occupied home, capped at ₹2 lakh."
                slider={{
                  kind: 'linear',
                  min: 0,
                  max: 2_00_000,
                  step: 5_000,
                  minLabel: '₹0',
                  maxLabel: '₹2 L',
                }}
                money
              />
            </div>
          </fieldset>
        </div>

        <div class="mt-6 border-t border-line pt-5">
          <button type="button" id="reset" class="btn btn-tertiary">
            Reset to defaults
          </button>
        </div>
      </div>

      <!-- Summary: beside the inputs on a wide screen, below them on a phone. -->
      <aside
        class="border-t border-line bg-[linear-gradient(180deg,var(--color-accent-soft),var(--color-surface-2)_55%)] lg:border-t-0 lg:border-l"
        aria-label="Result"
      >
        <div class="lg:sticky lg:top-20" data-summary>
          <div class="art-band" aria-hidden="true"></div>
          <!--
            The result is NOT a live region: re-announcing the whole breakdown on every keystroke is
            unusable with a screen reader. A short summary is announced instead, from #live.
          -->
          <p id="live" class="sr-only" role="status" aria-live="polite"></p>
          <output id="summary" for="calc" class="block" set:html={summary} />
          <div class="flex flex-wrap gap-2 border-t border-line px-6 py-5 sm:px-8 no-print">
            <button type="button" id="share" class="btn btn-primary flex-1">
              <Icon name="lucide:link" class="size-4" aria-hidden="true" />
              <span data-share-label>Share link</span>
            </button>
            <button type="button" id="export-pdf" class="btn btn-secondary">
              <Icon name="lucide:file-text" class="size-4" aria-hidden="true" /> PDF
            </button>
            <button type="button" id="export-xlsx" class="btn btn-secondary">
              <Icon name="lucide:file-spreadsheet" class="size-4" aria-hidden="true" /> Excel
            </button>
          </div>
        </div>
      </aside>
    </div>
  </div>

  <!-- The full breakdown -->
  <section class="mt-16" aria-labelledby="breakdown-heading">
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div>
        <p class="deva text-xl text-saffron-ink" lang="hi" aria-hidden="true">
          पूरा हिसाब
        </p>
        <h2 id="breakdown-heading" class="display mt-1 text-4xl text-ink">
          Full breakdown
        </h2>
        <p class="mt-1 text-sm text-ink-3">Every rupee, accounted for.</p>
      </div>
      <p class="text-sm text-ink-3">All figures a year, for the cheaper regime unless stated.</p>
    </div>
    <output id="details" for="calc" class="mt-8 block" set:html={details} />
  </section>

  <!--
    On a phone the result sits below the form, so the figure is off screen while you type. This
    bar appears once the summary scrolls out of view, keeping the number visible and making it
    obvious there is nothing to submit.
  -->
  <div
    id="sticky-total"
    hidden
    data-sticky-total
    class="glass fixed inset-x-0 bottom-0 z-40 border-t border-line px-4 pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] shadow-md lg:hidden"
  >
    <button
      type="button"
      class="flex w-full items-center justify-between gap-3 text-left"
      data-sticky-jump
    >
      <span class="flex items-center gap-1.5 text-sm text-ink-2">
        <span class="live-dot size-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        In hand per month
      </span>
      <span class="flex items-center gap-2">
        <span
          class="delta rounded-chip px-1.5 text-xs leading-5 font-medium tabular-nums"
          data-sticky-delta
          data-state="hidden"
          aria-hidden="true"
        ></span>
        <span
          class="relative text-xl font-semibold tracking-tight tabular-nums text-ink"
          data-sticky-value
        ></span>
      </span>
    </button>
  </div>
</form>

<script>
  import { mountCalculator } from '../scripts/calculator';
  mountCalculator();
</script>
