---
/** The InHand mark (see src/lib/brand.ts). Fixed brand colours, so it looks the same in any theme. */
import { logoSvg } from '../lib/brand';

interface Props {
  class?: string;
  /** Leave the rupee sign off the coin, for very small sizes. */
  plain?: boolean;
}
const { class: className, plain = false } = Astro.props;
const markup = logoSvg({ rupee: !plain }).replace(
  '<svg ',
  `<svg aria-hidden="true" focusable="false" class="${className ?? ''}" `,
);
---

<Fragment set:html={markup} />
