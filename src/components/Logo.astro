---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
// Each instance needs its own gradient id: the logo appears in the header and the footer.
const id = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-accent-2)"></stop>
      <stop offset="0.65" style="stop-color: var(--color-accent)"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="9" fill={`url(#${id})`}></rect>
  <!-- Outline bar = CTC, filled bar = what reaches your hand -->
  <rect
    x="8.5"
    y="7.5"
    width="6"
    height="17"
    rx="1.5"
    fill="none"
    stroke-width="1.8"
    class="stroke-on-accent"
  ></rect>
  <rect x="17.5" y="12" width="6" height="12.5" rx="1.5" class="fill-on-accent"></rect>
</svg>
