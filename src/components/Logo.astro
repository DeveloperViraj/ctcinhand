---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg viewBox="0 0 32 32" class={className} aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="7" class="fill-accent"></rect>
  <rect
    x="8.5"
    y="7.5"
    width="6"
    height="17"
    rx="1.5"
    fill="none"
    stroke-width="1.8"
    class="stroke-on-accent"
  ></rect>
  <rect x="17.5" y="12" width="6" height="12.5" rx="1.5" class="fill-on-accent"></rect>
</svg>
