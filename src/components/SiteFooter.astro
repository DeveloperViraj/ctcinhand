---
import { SITE } from '../config/site';

const verified = new Date(`${SITE.ratesVerifiedOn}T00:00:00+05:30`).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Kolkata',
});
const groups = [
  {
    label: 'Guides',
    links: [
      { href: '/in-hand-salary', label: 'In-hand salary by CTC' },
      { href: '/old-vs-new-tax-regime', label: 'Old vs new tax regime' },
      { href: '/hra-exemption', label: 'HRA exemption by city' },
      { href: '/marginal-relief', label: 'Marginal relief above ₹12 lakh' },
      { href: '/labour-code-wages', label: 'The Labour Code wage rule' },
      { href: '/provident-fund', label: 'Provident fund and the new ceiling' },
      { href: '/gratuity-calculator', label: 'Gratuity calculator' },
      { href: '/professional-tax', label: 'Professional tax by state' },
    ],
  },
  {
    label: 'About this site',
    links: [
      { href: '/how-it-works', label: 'How it works' },
      { href: '/embed-calculator', label: 'Embed this calculator' },
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
      { href: '/privacy', label: 'Privacy policy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 text-sm text-ink-2 sm:px-6 md:grid-cols-[1fr_auto]">
    <div class="max-w-prose space-y-2">
      <p class="font-medium text-ink">{SITE.name}</p>
      <p>
        Estimates for {SITE.taxYearLabel} under the Income-tax Act, 2025. Statutory rates were last
        checked against official sources on {verified}. This is not tax advice: confirm figures with
        your employer's payroll team or a chartered accountant before acting on them.
      </p>
    </div>
    <nav aria-label="Footer" class="grid gap-8 sm:grid-cols-2 md:gap-12">
      {groups.map((g) => (
        <div>
          <p class="font-medium text-ink">{g.label}</p>
          <ul class="mt-3 space-y-2">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="text-ink-2 hover:text-ink">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
