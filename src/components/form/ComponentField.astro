---
/**
 * A salary component that can be entered either as a percentage or as rupees a year: a number
 * chip with a unit switch beside it.
 */
import Segmented from './Segmented.astro';

interface Props {
  id: string;
  label: string;
  value: string;
  units: { value: string; label: string }[];
  unit: string;
  hint?: string;
  disabled?: boolean;
}

const { id, label, value, units, unit, hint, disabled = false } = Astro.props;
---

<div class="min-w-0">
  <label for={id} class="block text-sm text-ink-2">
    {label}
  </label>
  <div class="mt-2 flex items-center gap-2">
    <div class="chip min-w-0 flex-1" style="--chip-width:100%">
      <input
        id={id}
        name={id}
        type="text"
        inputmode="decimal"
        autocomplete="off"
        spellcheck="false"
        value={value}
        disabled={disabled}
        aria-describedby={hint ? `${id}-hint` : undefined}
        data-money
      />
    </div>
    <Segmented
      class="shrink-0"
      name={`${id}-unit`}
      ariaLabel={`${label}: entered as`}
      options={units}
      value={unit}
    />
  </div>
  {hint && (
    <p id={`${id}-hint`} class="mt-1.5 text-xs text-ink-3">
      {hint}
    </p>
  )}
</div>
