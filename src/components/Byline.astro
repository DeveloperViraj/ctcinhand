---
/**
 * "By <author>. Last updated <date>." The author part appears only once src/config/author.ts names
 * a real person; until then the line carries the date alone.
 */
import { AUTHOR } from '../config/author';
import { authorPath } from '../lib/seo';

interface Props {
  /** ISO date the content last changed materially. */
  updated: string;
  /** Name the author. Off for pages that speak for the site, such as the privacy policy. */
  credit?: boolean;
}

const { updated, credit = true } = Astro.props;
const initials = AUTHOR
  ? AUTHOR.name
      .split(/\s+/)
      .map((part) => part[0])
      .join('')
      .slice(0, 2)
      .toUpperCase()
  : '';
const label = new Date(`${updated}T00:00:00+05:30`).toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Kolkata',
});
---

<div class="mt-7 flex items-center gap-3 text-sm text-ink-3">
  {AUTHOR && credit && (
    <a
      href={authorPath(AUTHOR)}
      class="grid size-9 shrink-0 place-items-center rounded-full bg-[linear-gradient(135deg,var(--color-accent-2),var(--color-accent))] text-xs font-semibold text-on-accent no-underline"
      aria-hidden="true"
      tabindex="-1"
    >
      {initials}
    </a>
  )}
  <div class="leading-snug">
    {AUTHOR && credit && (
      <p>
        By{' '}
        <a href={authorPath(AUTHOR)} class="font-medium text-ink no-underline hover:underline">
          {AUTHOR.name}
        </a>
      </p>
    )}
    <p>
      Last updated <time datetime={updated}>{label}</time>
    </p>
  </div>
</div>
