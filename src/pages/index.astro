---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import { SITE } from '../config/site';
import { bracketLabel, bracketPath, lakhs } from '../lib/brackets';
import { calculate } from '../lib/tax/calculate';
import { DEFAULT_INPUT } from '../lib/tax/defaults';

const COMMON = [5, 6, 8, 10, 12, 14, 15, 18, 20, 25, 30, 40];

const verifiedLabel = new Date(`${SITE.ratesVerifiedOn}T00:00:00+05:30`).toLocaleDateString(
  'en-IN',
  { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' },
);

/** Share of CTC that reaches the bank in a year, with the calculator's standard structure. */
const reaches = (lpa: number) => {
  const r = calculate({ ...DEFAULT_INPUT, ctc: lakhs(lpa) });
  return `${Math.round((r.regimes[r.better].annualTakeHome / r.input.ctc) * 100)}%`;
};

const faqs = [
  {
    q: 'Why is my in-hand salary so much lower than my CTC?',
    a: `CTC includes money that never reaches your bank account: your employer’s provident fund contribution, the gratuity provision, employer ESI, and any variable pay you only receive if targets are met. Add income tax, your own PF contribution and professional tax. With a typical structure, about ${reaches(6)} of a ₹6 lakh CTC reaches your bank, ${reaches(12)} of ₹12 lakh, ${reaches(20)} of ₹20 lakh and ${reaches(50)} of ₹50 lakh. Below about ₹12 lakh provident fund and gratuity make up most of the gap; above it, income tax does. Variable pay widens it further.`,
  },
  {
    q: 'Which tax regime should I choose for FY 2026-27?',
    a: 'The new regime is the default and wins for most salaried people, because the standard deduction of ₹75,000 and the rebate under section 156 make income up to ₹12 lakh tax-free. The old regime can still win if you claim a large HRA exemption, a home loan interest deduction and a full ₹1.5 lakh under section 123 (the old 80C). This calculator shows both side by side so you do not have to guess.',
  },
  {
    q: 'Do the new Labour Codes mean my Basic pay must be half my CTC?',
    a: 'No. That is a common misreading. The Codes, in force since 21 November 2025, do not set a floor on Basic pay. They change how statutory wages are calculated: if the excluded allowances (HRA, conveyance, employer PF and similar) come to more than half of your total remuneration, the excess is treated as wages for PF, gratuity and ESI, even though it is still paid to you as an allowance. Your payslip need not change, but your gratuity and PF base can.',
  },
  {
    q: 'Is income up to ₹12 lakh really tax-free?',
    a: 'Under the new regime, a resident individual with ₹12 lakh of taxable income pays no tax, because the section 156 rebate of ₹60,000 cancels the tax due. With the ₹75,000 standard deduction, that corresponds to a gross salary of about ₹12.75 lakh. Just above ₹12 lakh, marginal relief caps the tax at the amount by which your income exceeds ₹12 lakh. The 4% cess is still added on top, so between ₹12 lakh and about ₹12.71 lakh of taxable income each extra rupee costs ₹1.04 in tax and take-home dips slightly, but you never face the ₹62,400 cliff that a calculator without relief would show.',
  },
  {
    q: 'How much professional tax will I pay?',
    a: 'It depends on your state, and it is capped at ₹2,500 a year by the Constitution. Maharashtra and Karnataka charge ₹300 in February and ₹200 in other months. Several states, including Delhi, Haryana, Uttar Pradesh and Rajasthan, do not levy it at all. Punjab charges ₹200 a month under a differently named Act, and Odisha abolished the tax from April 2026. Bihar takes the whole year’s tax from your September salary, and Kerala and Chennai charge it half-yearly. Where we have not verified a state’s slabs, we show zero and say so rather than guessing.',
  },
  {
    q: 'Does this calculator store my salary?',
    a: 'No. Everything is calculated in your browser and we keep no record of your figures. Your last inputs are saved in your own browser so you do not have to retype them. They also appear in the page address, so a result can be bookmarked or shared; anyone you send that link to can see them.',
  },
];

const schema = [
  {
    '@type': 'WebApplication',
    name: `${SITE.name} CTC Calculator`,
    '@id': `${SITE.url}/#calculator`,
    url: SITE.url,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    description: `Convert CTC to monthly in-hand salary for ${SITE.shortYearLabel}, comparing the new and old tax regimes.`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
    isAccessibleForFree: true,
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={`CTC to In-Hand Salary Calculator ${SITE.shortYearLabel}`}
  schema={schema}
  description="Work out your monthly in-hand salary from CTC for FY 2026-27. Both tax regimes side by side, with PF, ESI, gratuity, state professional tax and the Labour Code wage rule. Free, private, no sign-up."
>
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-6 sm:px-6 sm:pt-12 sm:pb-8">
    <h1 class="max-w-3xl text-2xl font-medium tracking-tight text-ink sm:text-3xl">
      CTC to in-hand salary calculator
    </h1>
    <p class="mt-2 max-w-2xl text-ink-2">
      What actually reaches your bank each month, with both tax regimes side by side.{' '}
      <span class="hidden sm:inline">
        Provident fund, ESI, gratuity, state professional tax and the Labour Code wage rule are all
        applied.
      </span>
    </p>
    <p class="mt-3 text-sm text-ink-3">
      {SITE.taxYearLabel}. Rates last verified on{' '}
      <time datetime={SITE.ratesVerifiedOn}>{verifiedLabel}</time>.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <Calculator />
  </section>

  <nav class="mx-auto mt-16 max-w-6xl px-4 sm:px-6" aria-labelledby="common-heading">
    <h2 id="common-heading" class="text-xl font-medium text-ink">
      In-hand salary at common CTCs
    </h2>
    <ul class="mt-4 flex flex-wrap gap-2">
      {COMMON.map((lpa) => (
        <li>
          <a href={bracketPath(lpa)} class="btn btn-secondary">
            {bracketLabel(lpa)}
          </a>
        </li>
      ))}
      <li class="flex items-center">
        <a href="/in-hand-salary" class="btn btn-tertiary ml-2">
          Every salary
        </a>
      </li>
    </ul>
  </nav>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="prose-doc">
        <h2>The Labour Code wage rule, in plain English</h2>
        <p>
          India&rsquo;s four Labour Codes took effect on <strong>21 November 2025</strong>. The part
          that affects your salary is a single definition of &ldquo;wages&rdquo;.
        </p>
        <p>
          You will often read that Basic pay must now be at least half of CTC. That is not what the
          law says. There is no floor on Basic. What the law does is change the <em>calculation</em>
          : if allowances such as HRA and conveyance, together with your employer&rsquo;s PF
          contribution, add up to more than half of your total remuneration, the excess is counted
          as wages anyway.
        </p>
        <p>
          The practical effect is that your provident fund, gratuity and ESI can be worked out on a
          higher figure than the Basic shown on your payslip. Your employer does not have to
          restructure your salary, and many are still working through it, but the statutory
          calculation applies now. This calculator applies it and tells you when it changed your
          numbers. <a href="/labour-code-wages">Worked examples</a>.
        </p>
      </div>

      <div class="prose-doc">
        <h2>What this calculator gets right</h2>
        <ul>
          <li>
            <strong>Marginal relief as a real cap.</strong> Just above &#8377;12 lakh, tax is capped
            at the income above &#8377;12 lakh, and at every surcharge threshold the extra tax is
            capped at the income above the threshold, with the 4% cess on top. Calculators that skip
            the cap show a cliff of tens of thousands of rupees.{' '}
            <a href="/marginal-relief">Worked example</a>.
          </li>
          <li>
            <strong>Professional tax month by month.</strong> Maharashtra and Karnataka charge
            &#8377;300 in February; West Bengal changed its whole schedule on 1 October 2026. A flat
            annual figure gets both wrong.
          </li>
          <li>
            <strong>The eight-city HRA rule.</strong> From this year Bengaluru, Hyderabad, Pune and
            Ahmedabad join the four old metros at 50% of Basic.{' '}
            <a href="/hra-exemption">What it is worth</a>.
          </li>
          <li>
            <strong>The new PF ceiling.</strong> The EPF wage ceiling rose from &#8377;15,000 to
            &#8377;25,000 on 17 September 2026. We apply it month by month instead of using one
            figure for the whole year. <a href="/provident-fund">Month-by-month tables</a>.
          </li>
          <li>
            <strong>Honest gaps.</strong> Where a state&rsquo;s slabs are not verified, we show zero
            and let you enter your payslip figure instead of inventing one.
          </li>
        </ul>
        <p>
          <a href="/how-it-works">Read the full method and sources</a>
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:px-6">
    <h2 class="text-xl font-semibold tracking-tight text-ink">Common questions</h2>
    <div class="mt-6 max-w-3xl divide-y divide-line border-t border-line">
      {faqs.map((f) => (
        <details class="group py-4">
          <summary class="cursor-pointer text-base font-medium text-ink">{f.q}</summary>
          <p class="mt-2 max-w-[68ch] text-ink-2">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
