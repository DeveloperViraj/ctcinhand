---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title={`CTC to In-Hand Salary Calculator, ${SITE.shortYearLabel} | ${SITE.name}`}
  description="Convert CTC to monthly in-hand salary for FY 2026-27. Compares the new and old tax regimes side by side, with PF, professional tax, HRA and the Labour Code 50% wage rule."
>
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-semibold tracking-tight">CTC to in-hand salary</h1>
    <p class="mt-2 text-ink-2">Calculator coming together. Rupee glyph check: ₹12,75,000</p>
    <p class="mt-6 text-figure font-semibold tabular-nums text-accent">₹84,210</p>
  </section>
</BaseLayout>
