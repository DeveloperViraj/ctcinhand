---
import DocLayout from '../../layouts/DocLayout.astro';
import ChartLine from '../../components/ChartLine.astro';
import { SITE } from '../../config/site';
import { bracketLabel, bracketPath, lakhs, LPA_BRACKETS } from '../../lib/brackets';
import { formatRupees } from '../../lib/format';
import { absolute } from '../../lib/seo';
import { calculate } from '../../lib/tax/calculate';
import { DEFAULT_INPUT } from '../../lib/tax/defaults';

const rows = LPA_BRACKETS.map((lpa) => {
  const result = calculate({ ...DEFAULT_INPUT, ctc: lakhs(lpa) });
  const best = result.regimes[result.better];
  return {
    lpa,
    monthly: best.monthlyTakeHome,
    tax: best.tax.totalTax,
    better: result.better,
    noTax: result.regimes.new.tax.totalTax < 0.5 && result.regimes.old.tax.totalTax < 0.5,
  };
});

// The chart covers the dense part of the range, where most people search.
const chartRows = rows.filter((r) => r.lpa <= 30);
const groups = [
  { label: 'Up to ₹10 lakh', rows: rows.filter((r) => r.lpa <= 10) },
  { label: '₹10 to ₹20 lakh', rows: rows.filter((r) => r.lpa > 10 && r.lpa <= 20) },
  { label: '₹20 to ₹30 lakh', rows: rows.filter((r) => r.lpa > 20 && r.lpa <= 30) },
  { label: 'Above ₹30 lakh', rows: rows.filter((r) => r.lpa > 30) },
];

const itemList = {
  '@type': 'ItemList',
  name: `In-hand salary by CTC, ${SITE.shortYearLabel}`,
  itemListElement: rows.map((row, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${bracketLabel(row.lpa)} in-hand salary`,
    url: absolute(bracketPath(row.lpa)),
  })),
};
---

<DocLayout
  title="In-hand salary for every CTC"
  description={`Monthly in-hand salary for every CTC from 3 to 100 LPA in ${SITE.shortYearLabel}, with the cheaper tax regime and the income tax at each salary. Each page breaks the number down.`}
  updated="2026-10-09"
  published="2026-10-04"
  ogImage="in-hand-salary"
  schema={[itemList]}
  about={['In-hand salary', 'Cost to company']}
  deva="वेतन"
>
  <p>
    What reaches your bank each month at every common salary, for {SITE.taxYearLabel}. Each figure
    uses the calculator's standard assumptions: Basic at half of CTC, PF capped at the statutory
    wage ceiling (₹25,000 from 17 September 2026), gratuity and employer PF inside the CTC, and
    Karnataka professional tax. Open any salary for the full breakdown, the state-by-state
    difference and the point at which the old regime would win, or read{' '}
    <a href="/ctc-vs-in-hand-salary">how CTC becomes in-hand pay</a>.
  </p>
  <p>
    Notice the stretch between 13.5 and 14 LPA, where take-home actually dips, by about ₹160 a
    month: the ₹12 lakh rebate ends there, and marginal relief plus the 4% cess take ₹1.04 of tax
    for every extra rupee. <a href="/marginal-relief">Why that happens</a>.
  </p>
  <ChartLine
    label="Monthly in-hand salary rises steadily with CTC from 3 to 30 LPA, with a small dip between 13.5 and 14 LPA."
    caption="Monthly in-hand salary at each CTC, with the calculator's standard structure."
    series={[
      {
        label: 'In hand a month',
        color: 'var(--color-accent)',
        area: true,
        points: chartRows.map((r) => ({ x: r.lpa, y: r.monthly })),
      },
    ]}
    xTicks={[3, 6, 9, 12, 15, 18, 21, 24, 27, 30]}
    yFormat={(y) =>
      y === 0
        ? '₹0'
        : y >= 1_00_000
          ? `₹${(y / 1_00_000).toFixed(1)} L`
          : `₹${Math.round(y / 1000)}k`
    }
    band={{ from: 13.5, to: 14, note: 'Take-home dips here' }}
  />

  <h2>Every salary, month by month</h2>
  {groups.map((g) => (
    <section class="not-prose mt-8">
      <h3 class="text-sm font-semibold text-ink-2">{g.label}</h3>
      <ul class="mt-3 grid grid-cols-2 gap-2.5 sm:grid-cols-3">
        {g.rows.map((row) => (
          <li>
            <a href={bracketPath(row.lpa)} class="tile block p-4">
              <span class="flex items-center justify-between gap-2">
                <span class="text-sm font-medium text-ink-2">{bracketLabel(row.lpa)}</span>
                <span class="text-[11px] font-medium text-ink-3">
                  {row.noTax ? 'No tax' : row.better === 'new' ? 'New regime' : 'Old regime'}
                </span>
              </span>
              <span class="mt-2 block font-display text-2xl font-bold tracking-tight tabular-nums text-ink">
                {formatRupees(row.monthly)}
              </span>
              <span class="block text-xs text-ink-3">
                a month{row.tax > 0 ? `, ${formatRupees(row.tax)} tax a year` : ''}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p>
    Your structure is probably different. <a href="/">Open the calculator</a> to set your own Basic,
    HRA, variable pay, city and deductions.
  </p>
</DocLayout>
