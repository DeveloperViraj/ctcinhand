---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<!--
  This site is fully static, so the host never generates a server-side 500. This page is the
  destination the calculator links to if something fails in the browser, and a stable URL for
  AdSense's error-page check.
-->
<BaseLayout title="Something went wrong" description="An unexpected error occurred." noindex>
  <section class="relative isolate">
    <div class="hero-glow" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32">
      <p class="display gradient-text text-7xl tabular-nums sm:text-[8rem]">500</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
        Something went wrong
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-ink-2">
        An unexpected error stopped the page from working. Reloading usually fixes it. If it keeps
        happening, clearing this site's saved data in your browser resets the calculator.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">
          Back to the calculator
        </a>
        <a href="/contact" class="btn btn-secondary">
          Report the problem
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
