---
import DocLayout from '../../layouts/DocLayout.astro';
import { SITE } from '../../config/site';
import { PT_STATE_PAGES } from '../../content/professional-tax';
import {
  computeProfessionalTax,
  FY_MONTHS,
  STATES,
  type PtCategory,
} from '../../lib/tax/professional-tax';
import { formatRupees } from '../../lib/format';

export function getStaticPaths() {
  const byCode = new Map(STATES.map((s) => [s.code, s]));
  return PT_STATE_PAGES.map((page) => ({
    params: { state: page.code.toLowerCase() },
    props: { page, name: byCode.get(page.code)!.name },
  }));
}

const { page, name } = Astro.props;

/** Example salaries, computed by the calculator itself so the table cannot drift from it. */
const EXAMPLES = [15_000, 25_000, 50_000, 1_00_000];

const FEB = FY_MONTHS.indexOf('Feb');
const OCT = FY_MONTHS.indexOf('Oct');

/** Turns twelve monthly amounts into a sentence, covering the February and mid-year cases. */
function describePattern(monthly: number[]): string {
  const distinct = new Set(monthly);
  if (distinct.size === 1) return `${formatRupees(monthly[0])} a month`;

  const withoutFeb = monthly.filter((_, i) => i !== FEB);
  if (new Set(withoutFeb).size === 1) {
    return `${formatRupees(withoutFeb[0])} a month, ${formatRupees(monthly[FEB])} in February`;
  }

  const firstHalf = new Set(monthly.slice(0, OCT));
  const secondHalf = new Set(monthly.slice(OCT));
  if (firstHalf.size === 1 && secondHalf.size === 1) {
    const from = formatRupees(monthly[0]);
    const to = monthly[OCT] === 0 ? 'nothing' : `${formatRupees(monthly[OCT])} a month`;
    return `${from} a month until September, then ${to}`;
  }

  return FY_MONTHS.map((m, i) => `${m} ${formatRupees(monthly[i])}`)
    .filter((_, i) => i === 0 || monthly[i] !== monthly[i - 1])
    .join(', then ');
}
const categories: PtCategory[] = page.code === 'MH' ? ['men', 'women'] : ['men'];

const rows = categories.flatMap((category) =>
  EXAMPLES.map((monthlyGross) => {
    const result = computeProfessionalTax(page.code, {
      monthlyGross,
      annualBonus: 0,
      age: 30,
      category,
      liableToIncomeTax: monthlyGross * 12 > 2_50_000,
    });
    return {
      category,
      monthlyGross,
      pattern: describePattern(result.monthly),
      annual: result.annual,
    };
  }),
);

const title = `Professional tax in ${name} (${SITE.shortYearLabel})`;
---

<DocLayout title={title} description={page.summary} updated="2026-09-25">
  <p>{page.summary}</p>

  <h2>How much you pay</h2>
  <ul>
    {page.rules.map((rule) => (
      <li>{rule}</li>
    ))}
  </ul>

  <h2>Worked examples</h2>
  <p>
    Calculated with the same engine as the <a href="/">calculator</a>, on a monthly gross salary:
  </p>
  <table>
    <thead>
      <tr>
        {page.code === 'MH' && <th>Slab</th>}
        <th>Monthly salary</th>
        <th>What is deducted</th>
        <th>Year total</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          {page.code === 'MH' && <td>{r.category === 'men' ? "Men's" : "Women's"}</td>}
          <td class="tabular-nums">{formatRupees(r.monthlyGross)}</td>
          <td>{r.annual === 0 ? 'Nothing' : r.pattern}</td>
          <td class="tabular-nums">{formatRupees(r.annual)}</td>
        </tr>
      ))}
    </tbody>
  </table>

  <h2>What counts as salary</h2>
  <p>{page.salaryBasis}</p>

  <h2>Who is exempt</h2>
  <ul>
    {page.exemptions.map((e) => (
      <li>{e}</li>
    ))}
  </ul>

  <h2>Where these figures come from</h2>
  <p>{page.authority}</p>
  {page.caveat && (
    <p class="rounded-md border border-warn-line bg-warn-soft px-3 py-2 text-warn-ink">
      {page.caveat}
    </p>
  )}

  <h2>Does it reduce your income tax?</h2>
  <p>
    Only in the old regime. Professional tax is deductible from salary under section 19(1) of the
    Income-tax Act, 2025, and section 202(2) removes that deduction for anyone taxed under the new
    regime.
  </p>

  <p>
    <a href={`/?st=${page.code}`}>See what this means for your take-home pay in {name}</a>
  </p>

  <h2>Other states</h2>
  <p>
    <a href="/professional-tax">Professional tax across India</a>
  </p>
</DocLayout>
