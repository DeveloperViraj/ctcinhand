---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <p class="text-sm font-medium text-ink-3 tabular-nums">404</p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight sm:text-3xl">This page doesn't exist</h1>
    <p class="mt-3 max-w-prose text-ink-2">
      The link may be out of date or mistyped. If you were opening a shared calculation, ask for the
      link again: it should start with the calculator's home page.
    </p>
    <p class="mt-8">
      <a
        href="/"
        class="inline-flex items-center rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-on-accent no-underline hover:bg-accent-strong"
      >
        Go to the calculator
      </a>
    </p>
  </section>
</BaseLayout>
