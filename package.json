{
  "name": "inhand",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run format:check && npm run check && npm run test && npm run build",
    "deploy:preview": "npm run build && wrangler pages dev ./dist",
    "deploy": "npm run verify && wrangler pages deploy ./dist --project-name=inhand",
    "lighthouse": "astro build && astro preview --port 4325 & lighthouse http://localhost:4325/ --view --chrome-flags=\"--headless=new\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.131",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "tailwindcss": "^4.3.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.12.0",
    "lighthouse": "^12.8.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
