/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  X-Frame-Options: SAMEORIGIN

# The embeddable calculator is meant to be framed by other sites.
/embed
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The site lives on ctcinhand.pages.dev for now, so that address must stay indexable. Every
# deployment also gets its own <hash>.ctcinhand.pages.dev copy: keep those out of search results.
# When a custom domain is added, put this back above the rule below, so only the domain is indexed:
#   https://:project.pages.dev/*
#     X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
